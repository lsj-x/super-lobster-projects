# 后端配置
APP_PORT=8080
LOG_LEVEL=info
ENV=production

# 模法师 API 配置
MM_API_BASE_URL=https://api.modelmagic.example.com
MM_API_KEY=your_api_key_here

# Kubernetes 配置（如果使用）
KUBECONFIG_PATH=/root/.kube/config
KUBERNETES_NAMESPACE=default

# 数据库配置（如果需要持久化）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=modelmagic_deploy

# 通知配置
NOTIFY_EMAIL_ENABLED=false
NOTIFY_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
